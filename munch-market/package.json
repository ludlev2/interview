{
  "name": "munch-market",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @munch-market/api dev\" \"pnpm --filter @munch-market/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm --filter @munch-market/api test",
    "test:e2e": "pnpm --filter @munch-market/api test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @munch-market/api db:migrate",
    "db:seed": "pnpm --filter @munch-market/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
